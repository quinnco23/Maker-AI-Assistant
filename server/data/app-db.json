  "knowledgeArticles": [
  {
    "id": "kb_1",
    "makerspaceId": "ms_1775240278729_qn43mo0k",
    "title": "How to Level a Prusa Bed (Quick Start)",
    "content": "1. Clean the build plate with isopropyl alcohol.\n2. Run automatic mesh bed leveling.\n3. Adjust live Z until first layer is smooth and slightly squished.\n4. Print a first layer test.\n\nTip: If lines are not sticking → go lower. If too squished → go higher.",
    "machineId": "machine_1775240278733_gxepzekm",
    "tags": ["3D Printing", "Setup", "Beginner"],
    "difficulty": "beginner",
    "createdAt": "2026-04-07T00:00:00.000Z",
    "updatedAt": "2026-04-07T00:00:00.000Z"
  },
  {
    "id": "kb_2",
    "makerspaceId": "ms_1775240278729_qn43mo0k",
    "title": "Fixing Stringing in 3D Prints",
    "content": "Common causes:\n- Temperature too high\n- Retraction too low\n\nFix:\n- Lower nozzle temp by 5–10°C\n- Increase retraction distance slightly\n- Enable combing in slicer\n\nQuick test: Print a retraction tower.",
    "tags": ["3D Printing", "Troubleshooting"],
    "difficulty": "beginner",
    "createdAt": "2026-04-07T00:00:00.000Z",
    "updatedAt": "2026-04-07T00:00:00.000Z"
  },
  {
    "id": "kb_3",
    "makerspaceId": "ms_1775240278729_qn43mo0k",
    "title": "PLA vs PETG: When to Use Each",
    "content": "PLA:\n- Easy to print\n- Good for prototypes\n- Lower strength\n\nPETG:\n- Stronger and more flexible\n- Better for functional parts\n- Slightly harder to print\n\nRule of thumb: PLA for learning, PETG for real-world use.",
    "tags": ["Materials", "3D Printing"],
    "difficulty": "beginner",
    "createdAt": "2026-04-07T00:00:00.000Z",
    "updatedAt": "2026-04-07T00:00:00.000Z"
  },
  {
    "id": "kb_4",
    "makerspaceId": "ms_1775240278729_qn43mo0k",
    "title": "First Print Checklist (Don’t Skip This)",
    "content": "Before printing:\n- Check bed is clean\n- Confirm correct filament loaded\n- Slice with correct profile\n- Watch first layer for 2–3 minutes\n\nMost failures happen in the first layer.",
    "tags": ["Checklist", "Beginner"],
    "difficulty": "beginner",
    "createdAt": "2026-04-07T00:00:00.000Z",
    "updatedAt": "2026-04-07T00:00:00.000Z"
  },
  {
    "id": "kb_5",
    "makerspaceId": "ms_1775240278729_qn43mo0k",
    "title": "Why Your Print Isn’t Sticking",
    "content": "Top causes:\n- Dirty bed\n- Incorrect Z height\n- Wrong temperature\n\nFix order:\n1. Clean bed\n2. Re-level\n3. Increase bed temp slightly\n\nIf still failing → use glue stick.",
    "tags": ["Troubleshooting"],
    "difficulty": "beginner",
    "createdAt": "2026-04-07T00:00:00.000Z",
    "updatedAt": "2026-04-07T00:00:00.000Z"
  }
